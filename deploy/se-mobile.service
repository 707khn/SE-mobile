[Unit]
Description=SE-mobile API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=semobile
Group=semobile
WorkingDirectory=/opt/se-mobile/se-mobile-backend
EnvironmentFile=/etc/se-mobile.env

# Три процесса, а не пять: на машине 2 ГБ памяти, и каждый рабочий процесс
# занимает около 100 МБ. Больше — начнёт вытеснять PostgreSQL.
#
# Но в каждом — четыре потока (gthread): синхронный процесс обслуживает один
# запрос за раз, и три процесса — это три запроса одновременно на всё
# предприятие. Загрузка листков держит процесс до 90 секунд, и в это время
# остальные 500 человек делили два. Потоки почти не едят памяти: 3×4 = 12
# запросов одновременно при тех же 300 МБ. Ждут они в основном базу, а не
# процессор, так что GIL здесь не мешает.
ExecStart=/opt/se-mobile/venv/bin/gunicorn \
    --workers 3 \
    --worker-class gthread \
    --threads 4 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=always
RestartSec=5

# Приложению нечего делать за пределами своей папки.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
